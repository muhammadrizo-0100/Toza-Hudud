# ==========================================
# TOZA HUDUD - ASOSIY MUHIT SOZLAMALARI
# ==========================================

# SERVER SOZLAMALARI
NODE_ENV=development
PORT=4000
API_PREFIX=api

# FRONTEND SOZLAMALARI
FRONTEND_URL=http://localhost:5173

# DATABASE (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=toza_hudud_db
DB_LOGGING=false

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT XAVFSIZLIK
JWT_SECRET=super_secret_jwt_key_toza_hudud_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=86400 # 24 soat (sekundlarda)
JWT_REFRESH_EXPIRES_IN=604800 # 7 kun

# TELEGRAM BOT SOZLAMALARI
# Fuqarolar uchun murojaat boti
TELEGRAM_BOT_TOKEN=your_citizen_bot_token_here
# Xodimlar/Haydovchilar uchun vazifalar boti (yoki bitta bot ichida role bo'yicha)
TELEGRAM_WORKER_BOT_TOKEN=your_worker_bot_token_here

# FAYL VA RASMLARNI YUKLASH
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=15

# GEOLOCATION / OSM NOMINATIM SOZLAMALARI
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
DEFAULT_MAP_LAT=41.0000
DEFAULT_MAP_LNG=71.6000
